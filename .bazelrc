# Two tiers: the default `bazel build //...` / `bazel test //...` skips targets tagged "heavy"
# (gRPC C++, C++ protobuf runtime, OpenSSL/BoringSSL/curl, crate_universe, Kotlin, GNU make from
# source, ...) so a cold run stays in the low minutes. `--config=full` builds and tests everything.
build --build_tag_filters=-heavy
test --test_tag_filters=-heavy
build:full --build_tag_filters=
test:full --test_tag_filters=

# Keep the workspace hermetic-ish and quiet.
common --enable_bzlmod
common --noenable_workspace
build --incompatible_strict_action_env
test --test_output=errors
build --show_progress_rate_limit=5
try-import %workspace%/user.bazelrc
common --repo_env=DO_NOT_TRACK=1
# protobuf >= 33.4 downloads a prebuilt protoc by default. Use --config=source_protoc to
# compile protoc from source instead (the heavier, older-style build).
build:source_protoc --@protobuf//bazel/flags:prefer_prebuilt_protoc=false
# Hermetic JDK for java_binary/java_test/kt_jvm_* (Bazel defaults to a host JDK).
build --java_runtime_version=remotejdk_21

# Note: a main repo whose top-level names clash case-insensitively (this repo once had `LICENSE`
# next to `license/`) breaks Bazel 9.x Skymeld symlink planting; see docs/bazel-skymeld-symlink-race.md.
# The clash is gone (the directory is `licensing/` now), so no workaround flag is needed.

# Toolchain variants. Defaults are what most projects use (host C/C++ compiler auto-detected by
# rules_cc, hermetic everything else); each config swaps one toolchain for the other common choice.
build:llvm --extra_toolchains=@llvm_toolchain//:all            # hermetic LLVM (toolchains_llvm)
build:host_clang --repo_env=CC=clang                            # host clang via rules_cc auto-config
build:host_gcc --repo_env=CC=gcc                                # host gcc via rules_cc auto-config
build:local_jdk --java_runtime_version=local_jdk --tool_java_runtime_version=local_jdk
build:local_python --extra_toolchains=@local_python_toolchains//:all
