# Appended to the variables emitted by ./configure.
all: libadd.a

add.o: add.c add.h
	$(CC) $(CFLAGS) -c -o add.o add.c

libadd.a: add.o
	ar rcs libadd.a add.o

install: libadd.a
	mkdir -p $(prefix)/lib $(prefix)/include
	cp libadd.a $(prefix)/lib/
	cp add.h $(prefix)/include/

clean:
	rm -f add.o libadd.a

.PHONY: all install clean
