# rules_go + gazelle smoke: BUILD files under go/ are generated by
# `bazel run //go:gazelle` (gazelle 0.54.0); go_library / go_binary / go_test /
# go_proto_library targets live in the subpackages.
load("@gazelle//:def.bzl", "gazelle")

# gazelle:prefix github.com/bcr-smoke-test/bcr-smoke-test/go
gazelle(
    name = "gazelle",
    # Only walk this directory; the rest of the repo is not Go.
    extra_args = ["go"],
)
