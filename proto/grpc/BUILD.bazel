# grpc smoke: cc_grpc_library (grpc_only = True, the modern convention) on top
# of proto_library + cc_proto_library, and a test that runs a real server.
load("@grpc//bazel:cc_grpc_library.bzl", "cc_grpc_library")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "greeter_proto",
    srcs = ["greeter.proto"],
)

cc_proto_library(
    name = "greeter_cc_proto",
    deps = [":greeter_proto"],
)

cc_grpc_library(
    name = "greeter_cc_grpc",
    srcs = [":greeter_proto"],
    grpc_only = True,
    deps = [":greeter_cc_proto"],
)

cc_test(
    name = "greeter_test",
    size = "small",
    srcs = ["greeter_test.cc"],
    deps = [
        ":greeter_cc_grpc",
        ":greeter_cc_proto",
        "@googletest//:gtest_main",
        "@grpc//:grpc++",
    ],
)
