# buildifier_prebuilt smoke: `bazel run //buildifier` formats the repo,
# `bazel run //buildifier:check` reports diffs/lint, and buildifier_test lints
# the listed BUILD/.bzl files (mode=diff, lint=warn) as part of `bazel test //...`.
load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")

# Every BUILD/.bzl file in the repo, linted hermetically (regenerate: tools/update_buildifier_list.py).
STARLARK_FILES = [
    "//:BUILD.bazel",
    "//:MODULE.bazel",
    "//apple:BUILD.bazel",
    ":BUILD.bazel",
    "//cc/libs:BUILD.bazel",
    "//cc:BUILD.bazel",
    "//cc_autoconf:BUILD.bazel",
    "//contrib/ape:BUILD.bazel",
    "//contrib/aspect_bazel_lib:BUILD.bazel",
    "//contrib/bazel_lib:BUILD.bazel",
    "//contrib/download_utils:BUILD.bazel",
    "//contrib/gnu:BUILD.bazel",
    "//contrib/jq:BUILD.bazel",
    "//contrib/multitool:BUILD.bazel",
    "//contrib/tar:BUILD.bazel",
    "//contrib/toml:BUILD.bazel",
    "//contrib/toml:config.bzl",
    "//contrib/toolchain_utils:BUILD.bazel",
    "//contrib/yq:BUILD.bazel",
    "//contrib:BUILD.bazel",
    "//foreign_cc/cmake_greet:BUILD.bazel",
    "//foreign_cc/configure_add:BUILD.bazel",
    "//foreign_cc/make_mul:BUILD.bazel",
    "//foreign_cc:BUILD.bazel",
    "//fuzzing:BUILD.bazel",
    "//go/cmd/hello:BUILD.bazel",
    "//go/greeter:BUILD.bazel",
    "//go/greetingpb:BUILD.bazel",
    "//go:BUILD.bazel",
    "//js/ts:BUILD.bazel",
    "//js:BUILD.bazel",
    "//jvm/java/com/example/greeter:BUILD.bazel",
    "//jvm/javatests/com/example/greeter:BUILD.bazel",
    "//jvm/kotlin:BUILD.bazel",
    "//jvm:BUILD.bazel",
    "//license:BUILD.bazel",
    "//license:licenses_used.bzl",
    "//perl:BUILD.bazel",
    "//pkg:BUILD.bazel",
    "//platforms:BUILD.bazel",
    "//python:BUILD.bazel",
    "//rust:BUILD.bazel",
    "//shell:BUILD.bazel",
    "//skylib:BUILD.bazel",
    "//skylib:features.bzl",
    "//skylib:features_test.bzl",
    "//skylib:greeting.bzl",
    "//skylib:greeting_test.bzl",
    "//stardoc:BUILD.bazel",
]

buildifier(
    name = "buildifier",
    exclude_patterns = ["./.git/*"],
    lint_mode = "fix",
    mode = "fix",
)

buildifier(
    name = "check",
    exclude_patterns = ["./.git/*"],
    lint_mode = "warn",
    mode = "diff",
)

buildifier_test(
    name = "buildifier_test",
    size = "small",
    srcs = STARLARK_FILES,
    lint_mode = "warn",
    mode = "diff",
)
