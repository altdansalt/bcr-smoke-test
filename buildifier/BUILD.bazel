# buildifier_prebuilt smoke: `bazel run //buildifier` formats the repo,
# `bazel run //buildifier:check` reports diffs/lint, and buildifier_test lints
# the listed BUILD/.bzl files (mode=diff, lint=warn) as part of `bazel test //...`.
load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")

# Files linted hermetically by the test (add new packages here). //:MODULE.bazel
# and //:BUILD.bazel would need exports_files() in the root BUILD; the run
# targets below cover them.
STARLARK_FILES = [
    "//cc:BUILD.bazel",
    "//cc/libs:BUILD.bazel",
    "//license:BUILD.bazel",
    "//license:licenses_used.bzl",
    "//platforms:BUILD.bazel",
    "//shell:BUILD.bazel",
    "//skylib:BUILD.bazel",
    "//skylib:features.bzl",
    "//skylib:features_test.bzl",
    "//skylib:greeting.bzl",
    "//skylib:greeting_test.bzl",
    "//stardoc:BUILD.bazel",
    ":BUILD.bazel",
]

buildifier(
    name = "buildifier",
    exclude_patterns = ["./.git/*"],
    lint_mode = "fix",
    mode = "fix",
)

buildifier(
    name = "check",
    exclude_patterns = ["./.git/*"],
    lint_mode = "warn",
    mode = "diff",
)

buildifier_test(
    name = "buildifier_test",
    size = "small",
    srcs = STARLARK_FILES,
    lint_mode = "warn",
    mode = "diff",
)
